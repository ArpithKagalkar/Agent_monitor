# OpenAI-compatible Otari endpoint. Keys belong to a specific region.
# US: https://api.otari.ai/api/v1
# EU: https://eu.api.otari.ai/api/v1
# Self-hosted: use the endpoint provided by your Otari administrator.
OTARI_BASE_URL=https://api.otari.ai/api/v1
OTARI_AGENT_KEY=
OTARI_AGENT_MODEL=

# A separate reviewer key is optional; blank reuses the agent key.
OTARI_JUDGE_KEY=

# Verified open-weight defaults for the opt-in Otari capability workflow.
OTARI_OPEN_AGENT_MODEL=mistral:mistral-small-2603
OTARI_JUDGE_MODEL=openai/gpt-oss-120b
OTARI_VISION_POLICY=agent-monitor-vision
OTARI_RESEARCH_URL=https://www.mozilla.org/en-US/about/
# A separate key capped at $0.01; used for a request with an estimated allowance
# larger than its cap, to demonstrate a native refusal without exhausting the agent.
OTARI_BUDGET_PROOF_KEY=
# Leave blank unless your Otari administrator has configured a native profile.
OTARI_GUARDRAIL_PROFILE=
OTARI_DOCS_MCP_SERVER=agent-monitor-docs

ENGINE_URL=http://localhost:8000
# Streamable HTTP transport; configure both MCP servers to expose /mcp.
# These are the initial shared configuration, to be smoke-tested with both servers.
MCP_GATEWAY_URL=http://localhost:8200/mcp
MCP_UPSTREAM_URL=http://localhost:8100/mcp
DB_PATH=store/agent_monitor.db
TOOL_STATE_PATH=work/tool_state.db
APPROVED_CRM_DESTINATIONS=approved-crm

# Optional, after P0. Fake email tools must never use a real mail service.
SLACK_WEBHOOK_URL=
